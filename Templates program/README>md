# Job.html
<!DOCTYPE html>
<html>
<head>
    <title>Jobs</title>
</head>
<body>

<h2>Add Job</h2>

<form method="POST">
    <input type="text" name="title" placeholder="Job Title" required><br><br>

    <input type="text" name="location" placeholder="Location" required><br><br>

    <input type="text" name="deadline" placeholder="Deadline" required><br><br>

    
    <select name="electrician_id">
        {% for e in electricians %}
            <option value="{{ e.id }}">{{ e.name }}</option>
        {% endfor %}
    </select><br><br>

    <button type="submit">Add Job</button>
</form>

<hr>

<h2>Jobs List</h2>

<ul>
    {% for j in jobs %}
        <li>
            {{ j.title }} - {{ j.location }} - {{ j.deadline }} 
    
        </li>

